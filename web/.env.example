# Base URL of the Spring Boot API (see ../api)
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1

# false = every page calls the API. true = the public, account and seller pages not wired
# yet show the mock data of src/lib/mock (development only: ignored by production builds).
# The backoffice and the sign-in always use the API.
NEXT_PUBLIC_USE_MOCKS=true

# Required: random secret of at least 32 characters, used only on the server.
SESSION_SECRET=
