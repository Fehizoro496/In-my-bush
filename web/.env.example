# Base URL of the Spring Boot API (see ../api)
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1

# Dev only: lets you open /compte, /vendre and /admin without a session.
# NEVER set to true in production.
NEXT_PUBLIC_AUTH_BYPASS=true

# true = pages read the mock data in src/lib/mock ; false = they call the API.
NEXT_PUBLIC_USE_MOCKS=true
